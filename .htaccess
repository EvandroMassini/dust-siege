# Impedir cache de TODOS os assets — sempre buscar versão atualizada do servidor
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|glb|gltf|bin|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Desativar compressão gzip para texto (evita cache intermediário)
<IfModule mod_deflate.c>
  DeflateFilterNote Off text/html
</IfModule>
